{
  "name": "anilist-mcp-server",
  "version": "0.10.0",
  "mcpName": "io.github.Grinv/anilist-mcp-server",
  "description": "MCP server for the AniList GraphQL API — anime/manga search, details, and personal list management.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Grinv",
    "email": "4070730+Grinv@users.noreply.github.com",
    "url": "https://github.com/Grinv"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grinv/anilist-mcp-server.git"
  },
  "homepage": "https://github.com/Grinv/anilist-mcp-server#readme",
  "bugs": "https://github.com/Grinv/anilist-mcp-server/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "anilist",
    "anime",
    "manga"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "anilist-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "PRIVACY.md",
    "SECURITY.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "build": "npm run typecheck && tsup",
    "prepublishOnly": "npm run build",
    "test": "node scripts/run-tests.ts",
    "test:coverage": "node scripts/run-tests.ts --coverage",
    "preversion": "node scripts/preversion-check.ts",
    "version": "node scripts/sync-version.ts && git add src/version.ts manifest.json server.json CHANGELOG.md",
    "lint": "eslint . && npm run typecheck:scripts",
    "check:api": "node scripts/check-api.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/index.js",
    "inspector": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
