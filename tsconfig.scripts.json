{
  // scripts/*.ts run directly through Node's native type stripping — never
  // emitted, so only erasable TypeScript syntax is allowed and relative
  // imports name the real ".ts" file. eslint.config.mjs stays plain JS
  // (ESLint loads a .ts config only via jiti or an unstable flag) and is
  // checked here through allowJs/checkJs. tsup.config.ts is loaded by tsup
  // itself, and is listed here only so it gets type-checked at all.
  "compilerOptions": {
    "target": "ES2024",
    "module": "node20",
    "lib": ["ES2024"],
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": ["scripts/**/*.ts", "eslint.config.mjs", "tsup.config.ts"]
}
